# Pasta de ficheiros enviados por utilizadores.
#
# Esta pasta tem conteudo de dois tipos e eles NAO podem ser tratados da mesma
# maneira:
#
#   PUBLICO   restaurantes/logos  (logotipo mostrado nas paginas e no cardapio)
#             reserva-qr          (QR enviado ao cliente; abre pelo endereco)
#             usuarios            (fotos de perfil)
#
#   PRIVADO   comprovativos             (documentos bancarios)
#             documentos_titularidade   (documentos de identidade)
#
# Os privados vivem hoje fora da raiz do site, em nv_storage('privado'), e so
# saem pelo comprovativo_arquivo.php, que confirma a sessao. As regras abaixo
# ficam como segunda barreira, para o caso de algum ficheiro antigo ter ficado
# para tras ou de alguem voltar a gravar aqui por engano.
#
# ATENCAO a quem mexer nisto: um "Require all denied" aplicado a esta pasta
# inteira bloqueia tambem os logotipos e os QR das reservas. Ja aconteceu.

# --- 1) As duas pastas privadas: nada sai daqui pelo endereco directo.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(comprovativos|documentos_titularidade)(/|$) - [F,L]
</IfModule>

# Se o mod_rewrite nao existir, o acesso directo a essas pastas fica a cargo
# do armazenamento privado, que e onde os ficheiros realmente estao.

# --- 2) Em toda a pasta: nada corre como codigo.
# Um ficheiro enviado nunca deve ser executado, mesmo que passe pela validacao
# de tipo. Isto vale tanto para o publico como para o privado.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .phar .cgi .pl .py .sh
RemoveHandler .php .phtml .phar
